# ---- credentials ----
MRKT_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- MRKT endpoints (NO public API — VERIFY these against real traffic) ----
MRKT_BASE_URL=https://api.mrkt.io
MRKT_LISTINGS_PATH=/v1/collections/{collection}/listings
MRKT_BUY_PATH=/v1/listings/{listing_id}/buy
MRKT_SALES_PATH=/v1/collections/{collection}/sales

# ---- targeting ----
COLLECTIONS=vice,cream,chill,flame
MODE=notify            # notify | auto_buy

# ---- profit / safety ----
MIN_PROFIT_TON=0.03
MIN_PROFIT_PCT=0.05
SAFETY_MARGIN_PCT=0.03
MAX_BUY_PRICE_TON=
SCAM_PRICE_RATIO=0.15

# ---- floor robustness ----
FLOOR_SAMPLE_SIZE=15
FLOOR_OUTLIER_RATIO=0.5

# ---- liquidity gate ----
MIN_LIQUIDITY_LISTINGS=12
MIN_RECENT_SALES=3

# ---- fees ----
MARKETPLACE_FEE_PCT=0.05
NETWORK_FEE_TON=0.01

# ---- timing ----
WATCH_INTERVAL_SEC=3
FLOOR_REFRESH_SEC=120   # capped at 360 (6 min)

# ---- rate limiting / anti-429 ----
REQUEST_RATE_PER_SEC=4
REQUEST_BURST=8
MAX_RETRIES=5
BACKOFF_BASE_SEC=0.5
BACKOFF_MAX_SEC=30
REQUEST_TIMEOUT_SEC=8

# ---- misc ----
STATE_PATH=mrkt_sniper_state.json
DRY_RUN=false
